/*
id: studio_ten
name: Studio Ten
author: mineblockz27
borders: true
*/
body {
	--color-ui: #2e2e2e;
	--color-back: #282828;
	--color-dark: #7f7f7f;
	--color-border: #212121;
	--color-selected: #585858;
	--color-elevated: #1c1c1c;
	--color-button: #27c049;
	--color-bright_ui: #686868;
	--color-accent: #505051;
	--color-frame: #1a1a1a;
	--color-text: #ffffff;
	--color-light: #7a7a7a;
	--color-accent_text: #ffffff;
	--color-bright_ui_text: #ffffff;
	--color-subtle_text: #ffffff;
	--color-grid: #000000;
	--color-wireframe: #434343;
	--color-checkerboard: #252525;
}
@scope (thumbnail) {
div.theme_preview {
	    border-radius: 10px;
	    background: rgba(60, 65, 60, 0.85);
	    overflow: hidden;
	}
	
	div.theme_preview_header {
	    border-radius: 10px 10px 0px 0px;
	    background: rgba(75, 90, 75, 0.85);
	}
	
	div.theme_preview_sidebar {
	    border-radius: 0px 0px 10px 10px;
	    background: rgba(90, 95, 90, 0.7);
	}
	
	div.theme_preview_sidebar::after {
	    border-radius: 0px 0px 10px 10px;
	}
	
	div.theme_preview_window {
	    border-radius: 0px 0px 10px 10px;
	    background: rgba(70, 75, 70, 0.85);
	}
	
	div.theme_preview_menu {
	    border-radius: 10px;
	    background: rgba(80, 110, 85, 0.6);
	    border: 1px solid rgba(140, 200, 150, 0.3);
	}
	
	div.theme_preview_menu_header {
	    border-radius: 0px 0px 5px 5px;
	    background: rgba(100, 160, 110, 0.9);
	}
}
@font-face {
    font-family: 'MinecraftRegular';
    src: url(data:font/opentype;charset=utf-8;base64,) format('opentype');
}

@font-face {
    font-family: 'MinecraftTen';
    src: url(data:font/truetype;charset=utf-8;base64,) format('truetype');
}

body {
    font-family: 'MinecraftRegular', sans-serif !important;
}

h1, h2, h3,
.dialog_title,
.dialog_bar h3,
.panel_headline,
.tab,
.title_bar_title,
#name_bar,
.action_control_search_title {
    font-family: 'MinecraftTen', sans-serif !important;
}

/*
Made by mineblockz27 
Version 1.1
*/


.contextMenu {
    border-radius: 0px;
    backdrop-filter: blur(10px);
    background-color: rgba(0, 0, 0, 0.45);
    transition: background-color 0.2s;
    animation: context_menu 0.15s;
}

.contextMenu.sub {
    border-radius: 0px;
    backdrop-filter: blur(10px);
    background-color: rgba(0, 0, 0, 0.9);
    border: solid 0px rgba(27, 21, 23, 0.6);
}

.dropdown-content {
    border-radius: 14px;
    backdrop-filter: blur(10px);
    background-color: rgba(255, 255, 255, 0.2);
    border: solid 2px rgba(27, 21, 23, 0.3);
}